# Next.js web — environment variables
#
# Optional. Web app runs fully offline (embedded rates + client Report Center).
# Set this on the Vercel *web* project to enable Rates → Sync from API.
#
# Must include the /api suffix (Nest global prefix).
#
# Local development (default when unset in NODE_ENV=development):
#   http://localhost:4000/api
#
# Production example (your deployed Nest project):
NEXT_PUBLIC_API_URL=https://boq-generator-api-5nz3.vercel.app/api
