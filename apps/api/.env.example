# NestJS API — environment variables
#
# Required for database-backed rates (optional; engine defaults used if DB unavailable)
DATABASE_URL="postgresql://boq:boq@localhost:5432/boq_pro?schema=public"

# Server port (Vercel sets PORT automatically)
PORT=4000

# Comma-separated exact frontend origins allowed for CORS.
# Leave unset in development to allow localhost + *.vercel.app automatically.
# Example production:
# CORS_ORIGIN="https://boq-generator.vercel.app,https://boq-generator-git-main-xxx.vercel.app"
CORS_ORIGIN="http://localhost:3000"
