{
  "name": "@boq/geometry",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "templates:seed": "node ./scripts/seed-house-templates.mjs",
    "templates:sync": "node ./scripts/sync-templates.mjs",
    "prebuild": "npm run templates:sync",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@boq/shared": "*",
    "@boq/engine": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
